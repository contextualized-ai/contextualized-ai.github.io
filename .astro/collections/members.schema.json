  "type": "object",
  "properties": {
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "roleEs": {
      "type": "string"
    },
    "roleEn": {
      "type": "string"
    },
    "focusEs": {
      "type": "string"
    },
    "focusEn": {
      "type": "string"
    },
    "link": {
      "type": "string",
