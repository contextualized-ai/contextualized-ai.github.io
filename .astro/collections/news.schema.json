{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "year": {
      "type": "string"
    },
    "textEs": {
      "type": "string"
    },
    "textEn": {
      "type": "string"
    },
    "images": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "altEs": {
            "type": "string"
          },
          "altEn": {
            "type": "string"
          }
        },
        "required": [
          "image",
          "altEs",
          "altEn"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "year",
    "textEs",
    "textEn"
  ]
}