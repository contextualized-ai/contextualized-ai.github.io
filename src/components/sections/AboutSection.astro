---
import Section from '../Section.astro';
import { getCollection } from 'astro:content';

const [about] = await getCollection('about');

if (!about) {
  throw new Error('Add an about entry to src/content/about before building the site.');
}
---

<Section id="acerca-de" titleEs="Acerca de" titleEn="About">
  <p
    class="intro"
    data-es={about.data.introEs}
    data-en={about.data.introEn}
  >
    {about.data.introEs}
  </p>
</Section>
