---
import Section from '../Section.astro';
import { getCollection } from 'astro:content';

const [about] = await getCollection('about');

if (!about || !about.body) {
  throw new Error('Add an about entry with content to src/content/about before building the site.');
}
const rawContent = about.body;

// español separa al inglés con "---"
const [esContent, enContent] = rawContent.split('---').map(text => text.trim());

import { marked } from 'marked';
const htmlEs = marked.parse(esContent);
const htmlEn = marked.parse(enContent);
---

<Section id="acerca-de" titleEs="Acerca de" titleEn="About">
  <div class="content-body about-content" data-lang="es" set:html={htmlEs} />
  <div class="content-body about-content" data-lang="en" set:html={htmlEn} />
</Section>