---
import Section from '../Section.astro';
import TimelineItem from '../shared/TimelineItem.astro';
import NewsCarousel from '../shared/NewsCarousel.astro';
import { getCollection } from 'astro:content';

const newsItems = (await getCollection('news'))
  .sort((first, second) => Number(second.data.year) - Number(first.data.year));
---

<Section id="noticias" titleEs="Noticias" titleEn="News">
  <ul class="timeline-list">
    {newsItems.map((item) => (
      <TimelineItem year={item.data.year}>
        <div>
          <p class="news-text" data-es={item.data.textEs} data-en={item.data.textEn}>{item.data.textEs}</p>
          {item.data.images.length > 0 && <NewsCarousel images={item.data.images} />}
        </div>
      </TimelineItem>
    ))}
  </ul>
</Section>
