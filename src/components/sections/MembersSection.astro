---
import Section from '../Section.astro';
import MemberCard from '../shared/MemberCard.astro';
import { getEntry } from 'astro:content';

const team = await getEntry('members', 'team');
if (!team) throw new Error('The team content entry is missing.');

const {
  directora,
  investigadoresDocentesResponsables,
  investigadoraConicet,
  doctorandos,
  investigadoresDoctoradosFormados,
} = team.data;
---

<Section id="miembros" titleEs="Miembros" titleEn="Members">
  <section class="team-group" aria-labelledby="directora-heading">
    <h3 class="team-subheading" id="directora-heading" data-es="Directora" data-en="Director">
      Directora
    </h3>
    <div class="team-list">
      {directora.map((member) => <MemberCard member={member} />)}
    </div>
  </section>

  <section class="team-group" aria-labelledby="investigadores-docentes-heading">
    <h3 class="team-subheading" id="investigadores-docentes-heading" data-es="Investigadores docentes responsables" data-en="Responsible teaching researchers">
      Investigadores docentes responsables
    </h3>
    {investigadoresDocentesResponsables.length > 0 ? (
      <div class="team-list">
        {investigadoresDocentesResponsables.map((member) => <MemberCard member={member} />)}
      </div>
    ) : (
      <p class="empty-state" data-es="Todavía no hay investigadores docentes responsables." data-en="There are no responsible teaching researchers listed yet.">
        Todavía no hay investigadores docentes responsables.
      </p>
    )}
  </section>

  <section class="team-group" aria-labelledby="investigadora-conicet-heading">
    <h3 class="team-subheading" id="investigadora-conicet-heading" data-es="Investigadora CONICET" data-en="CONICET researcher">
      Investigadora CONICET
    </h3>
    {investigadoraConicet.length > 0 ? (
      <div class="team-list">
        {investigadoraConicet.map((member) => <MemberCard member={member} />)}
      </div>
    ) : (
      <p class="empty-state" data-es="Todavía no hay investigadora CONICET publicada." data-en="There are no CONICET researchers listed yet.">
        Todavía no hay investigadora CONICET publicada.
      </p>
    )}
  </section>

  <section class="team-group" aria-labelledby="doctorandos-heading">
    <h3 class="team-subheading" id="doctorandos-heading" data-es="Doctorandos" data-en="PhD students">
      Doctorandos
    </h3>
    {doctorandos.length > 0 ? (
      <div class="team-list">
        {doctorandos.map((member) => <MemberCard member={member} />)}
      </div>
    ) : (
      <p class="empty-state" data-es="Todavía no hay doctorandos publicados." data-en="There are no PhD students listed yet.">
        Todavía no hay doctorandos publicados.
      </p>
    )}
  </section>

  <section class="team-group" aria-labelledby="doctorados-formados-heading">
    <h3 class="team-subheading" id="doctorados-formados-heading" data-es="Investigadores doctorados formados en el equipo" data-en="Researchers with doctorates formed in the team">
      Investigadores doctorados formados en el equipo
    </h3>
    {investigadoresDoctoradosFormados.length > 0 ? (
      <div class="team-list alumni-list">
        {investigadoresDoctoradosFormados.map((member) => <MemberCard member={member} />)}
      </div>
    ) : (
      <p class="empty-state" data-es="Todavía no hay investigadores doctorados formados en el equipo." data-en="There are no researchers with doctorates formed in the team yet.">
        Todavía no hay investigadores doctorados formados en el equipo.
      </p>
    )}
  </section>
</Section>
